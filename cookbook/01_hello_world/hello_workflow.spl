-- Recipe: 01_hello_world (dsh-spl WORKFLOW rewrite)
-- Original hello.spl uses PROMPT/SELECT syntax (spl3 only).
-- This version uses WORKFLOW syntax understood by the dsh-spl TypeScript engine.

CREATE FUNCTION greeting(user_input TEXT, lang TEXT)
RETURNS TEXT AS $$
You are a friendly AI assistant.
The user said: "{user_input}"

Please respond in {lang}.
$$;

WORKFLOW hello_world
INPUT:
  @user_input TEXT DEFAULT 'Explain SQL'
  @lang TEXT DEFAULT 'English'
OUTPUT:
  @result
DO
  GENERATE greeting(@user_input, @lang) INTO @result
  RETURN @result
END
